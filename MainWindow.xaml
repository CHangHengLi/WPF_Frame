<Window x:Class="WPF_Frame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Frame"
        mc:Ignorable="d"
        Title="WPF Frame控件演示" Height="600" Width="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- 侧边栏导航菜单 -->
        <StackPanel Grid.Column="0" Background="#f0f0f0">
            <TextBlock Text="应用导航" FontSize="20" FontWeight="Bold" Margin="10" HorizontalAlignment="Center"/>
            <Button x:Name="btnHome" Content="首页" Click="NavButton_Click" Tag="Home" Margin="10,5" Height="40"/>
            <Button x:Name="btnProducts" Content="产品" Click="NavButton_Click" Tag="Products" Margin="10,5" Height="40"/>
            <Button x:Name="btnSettings" Content="设置" Click="NavButton_Click" Tag="Settings" Margin="10,5" Height="40"/>
            <Button x:Name="btnAbout" Content="关于" Click="NavButton_Click" Tag="About" Margin="10,5" Height="40"/>
            
            <Separator Margin="10,20"/>
            
            <!-- 导航控制 -->
            <StackPanel Margin="10">
                <TextBlock Text="导航控制" FontWeight="Bold" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnBack" Content="后退" Click="btnBack_Click" Margin="0,0,2,0" Grid.Column="0" IsEnabled="False"/>
                    <Button x:Name="btnForward" Content="前进" Click="btnForward_Click" Margin="2,0,2,0" Grid.Column="1" IsEnabled="False"/>
                    <Button x:Name="btnHistory" Content="历史" Click="btnHistory_Click" Margin="2,0,0,0" Grid.Column="2"/>
                </Grid>
            </StackPanel>
        </StackPanel>
        
        <!-- 主内容区域 -->
        <Frame x:Name="MainFrame" 
               Grid.Column="1" 
               NavigationUIVisibility="Hidden" 
               Navigated="MainFrame_Navigated"
               Background="White"/>
    </Grid>
</Window>
