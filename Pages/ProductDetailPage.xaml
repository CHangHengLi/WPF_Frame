<Page
    x:Class="WPF_Frame.Pages.ProductDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPF_Frame.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="产品详情"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <TextBlock
            x:Name="productTitle"
            Margin="20"
            HorizontalAlignment="Center"
            FontSize="24"
            FontWeight="Bold"
            Text="产品详情" />

        <!--  详情内容  -->
        <Grid Grid.Row="1" Margin="40,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  产品图标  -->
            <Border
                Grid.Column="0"
                Width="250"
                Height="250"
                Margin="0,0,30,0"
                Background="#F5F5F5"
                BorderBrush="#DDDDDD"
                BorderThickness="1">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="100"
                    Text="📱" />
            </Border>

            <!--  产品信息  -->
            <StackPanel Grid.Column="1">
                <TextBlock
                    x:Name="productName"
                    FontSize="22"
                    FontWeight="Bold" />
                <TextBlock
                    x:Name="productPrice"
                    Margin="0,10,0,0"
                    FontSize="18"
                    Foreground="#007ACC" />
                <Separator Margin="0,15" />
                <TextBlock
                    Margin="0,10,0,5"
                    FontSize="16"
                    FontWeight="Bold"
                    Text="产品描述" />
                <TextBlock x:Name="productDescription" TextWrapping="Wrap" />

                <!--  额外的产品信息  -->
                <Separator Margin="0,15" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        FontWeight="Bold"
                        Text="商品编号：" />
                    <TextBlock
                        x:Name="productId"
                        Grid.Row="0"
                        Grid.Column="1" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,5,0,0"
                        FontWeight="Bold"
                        Text="库存状态：" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,5,0,0"
                        Foreground="Green"
                        Text="有货" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,5,0,0"
                        FontWeight="Bold"
                        Text="配送信息：" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,5,0,0"
                        Text="免费配送" />
                </Grid>
            </StackPanel>
        </Grid>

        <!--  底部按钮  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,10,0,20"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Button
                Width="120"
                Height="35"
                Margin="10,0"
                Click="BackButton_Click"
                Content="返回列表" />
            <Button
                Width="120"
                Height="35"
                Margin="10,0"
                Background="#007ACC"
                Content="加入购物车"
                Foreground="White" />
        </StackPanel>
    </Grid>
</Page> 